# ── 3D construction scene (homepage "How we build") ─────────────────────────────
# Ops kill-switch for the WebGL scene. Set to "0" (or "false") to serve the static
# blueprint poster everywhere instead of mounting three.js — use if the scene ever
# needs to be disabled site-wide without a code change. Any other value / unset =
# scene enabled (default).
NEXT_PUBLIC_SCENE_V2=1
